{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Codex-Turnloom Mobile",
    "version": "1.0.0",
    "date": "2026-10-23",
    "platform": "Android",
    "baseViewport": "390x844",
    "description": "Design tokens extracted and normalized from the current Codex-Turnloom mobile UI. Values are recommendations for redesign handoff."
  },
  "color": {
    "base": {
      "bg": "#F5F5F7",
      "panel": "#FFFFFF",
      "panelSoft": "#F5F5F7",
      "border": "#E0E0E5",
      "text": "#1D1D1F",
      "muted": "#6E6E73",
      "placeholder": "#8A8A8E"
    },
    "action": {
      "accent": "#0066CC",
      "accentSoft": "#E8F2FF",
      "accentPressed": "#0055AD",
      "focusRing": "rgba(0, 102, 204, 0.28)"
    },
    "surface": {
      "userBubble": "#E8F2FF",
      "assistantBubble": "#FFFFFF",
      "toolBubble": "#ECECF0",
      "noticeBubble": "#FFF4D8",
      "interactionBubble": "#FFF0F0",
      "selectedRow": "#E7F1FF",
      "hoverRow": "#EDEDF1",
      "codeBlock": "#25231F",
      "inlineCode": "#EDF1F5"
    },
    "semantic": {
      "online": "#228B54",
      "offline": "#B53737",
      "running": "#B86B18",
      "waiting": "#B24C42",
      "ended": "#2C8A57",
      "unknown": "#7A8490",
      "checking": "#AAB2BA",
      "link": "#1768DA",
      "dangerText": "#A13F3A",
      "dangerSoft": "#FFF8F7",
      "successSoft": "#EAF4EF",
      "successText": "#1F5F50",
      "noticeText": "#5E470D",
      "interactionText": "#7D2C28"
    },
    "brand": {
      "blue": "#2563EB",
      "mint": "#56D9B5",
      "coral": "#FF6B4A",
      "white": "#FFFFFF"
    }
  },
  "typography": {
    "family": {
      "sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace"
    },
    "size": {
      "display": "28px",
      "pageTitle": "20px",
      "mobileTitle": "17px",
      "section": "16px",
      "body": "16px",
      "compact": "14px",
      "meta": "12px",
      "micro": "11px",
      "tiny": "10px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "heavy": 750
    },
    "lineHeight": {
      "tight": 1.2,
      "snug": 1.35,
      "normal": 1.45,
      "relaxed": 1.55
    },
    "letterSpacing": {
      "tight": "-0.2px",
      "normal": "0",
      "eyebrow": "0.08em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "6px",
    "3": "8px",
    "4": "10px",
    "5": "12px",
    "6": "14px",
    "7": "16px",
    "8": "18px",
    "9": "20px",
    "10": "22px",
    "11": "24px",
    "12": "28px",
    "13": "32px",
    "14": "40px",
    "15": "48px"
  },
  "radius": {
    "xs": "6px",
    "sm": "8px",
    "md": "12px",
    "lg": "14px",
    "xl": "16px",
    "2xl": "18px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 10px 26px rgba(38, 35, 31, 0.08)",
    "dialog": "0 24px 70px rgba(0, 0, 0, 0.12)",
    "welcome": "0 28px 90px rgba(0, 0, 0, 0.24)",
    "drawer": "16px 0 34px rgba(38, 35, 31, 0.18)",
    "fab": "0 8px 24px rgba(0, 0, 0, 0.12)",
    "none": "none"
  },
  "size": {
    "touchMin": "44px",
    "iconButton": "40px",
    "iconButtonCompact": "36px",
    "primaryButtonHeight": "48px",
    "secondaryButtonHeight": "46px",
    "inputHeight": "48px",
    "composerMinHeight": "50px",
    "composerMaxHeight": "170px",
    "appBarHeight": "64px",
    "nativeTopBarHeight": "52px",
    "conversationHeaderHeight": "58px",
    "drawerWidth": "min(88vw, 380px)",
    "sidebarMaxWidth": "380px",
    "messageMaxWidth": "980px",
    "bubbleRadius": "12px",
    "avatarSize": "22px",
    "statusDot": "6px",
    "progressBarHeight": "2px",
    "scrollToBottomSize": "38px"
  },
  "breakpoint": {
    "phonePortraitMax": "760px",
    "smallPhoneMax": "520px",
    "tinyPhoneMax": "360px",
    "desktopMin": "761px"
  },
  "motion": {
    "duration": {
      "fast": "140ms",
      "normal": "160ms",
      "drawer": "240ms",
      "page": "200ms"
    },
    "easing": {
      "standard": "ease",
      "drawer": "cubic-bezier(0.22, 1, 0.36, 1)",
      "out": "ease-out"
    },
    "thinkingDots": "1.1s steps(4, end) infinite"
  },
  "opacity": {
    "disabled": 0.4,
    "disabledStrong": 0.55,
    "muted": 0.7
  },
  "component": {
    "threadItem": {
      "height": "56px",
      "radius": "8px",
      "padding": "9px 12px"
    },
    "computerRow": {
      "height": "82px",
      "heightWithNote": "98px",
      "padding": "12px 8px 12px 16px"
    },
    "bubble": {
      "padding": "14px 16px",
      "radius": "12px"
    },
    "composer": {
      "padding": "12px 20px 14px",
      "paddingMobile": "10px 12px 12px",
      "gap": "10px"
    },
    "authCard": {
      "maxWidth": "390px",
      "padding": "28px",
      "gap": "14px"
    },
    "welcomeCard": {
      "maxWidth": "560px",
      "radius": "18px",
      "radiusMobile": "14px"
    },
    "approvalButton": {
      "height": "32px",
      "radius": "7px",
      "padding": "0 12px"
    }
  },
  "notes": [
    "Current implementation contains legacy green/yellow surfaces; this token file promotes the blue action system as the canonical direction.",
    "Touch target minimum is 44px even where the current implementation uses 32–40px icons.",
    "Use 8/12/16/999 radius steps in new designs to reduce current 6/7/8/12/14/18 fragmentation."
  ]
}
